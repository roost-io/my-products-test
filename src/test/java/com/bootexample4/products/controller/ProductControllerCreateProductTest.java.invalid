package com.bootexample4.products.controller;import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;
import org.junit.jupiter.params.provider.MethodSource;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;
import java.util.stream.Stream;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerCreateProductTest {
    @Mock
    private ProductRepository productRepository;
    @InjectMocks
    private ProductController productController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    @DisplayName("Should successfully create a product with valid attributes")
    void createProductSuccessfully() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("Test Product");
        inputProduct.setDescription("Test Description");
        inputProduct.setPrice(new BigDecimal("99.99"));
        Product savedProduct = new Product();
        savedProduct.setId(1L);
        savedProduct.setName("Test Product");
        savedProduct.setDescription("Test Description");
        savedProduct.setPrice(new BigDecimal("99.99"));
        when(productRepository.save(any(Product.class))).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(inputProduct);
        // Assert
        assertNotNull(result);
        assertEquals(1L, result.getId());
        assertEquals("Test Product", result.getName());
        assertEquals("Test Description", result.getDescription());
        assertEquals(new BigDecimal("99.99"), result.getPrice());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("invalid")
    @DisplayName("Should handle product creation with null values")
    void createProductWithNullValues() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName(null);
        inputProduct.setDescription(null);
        inputProduct.setPrice(null);
        Product savedProduct = new Product();
        savedProduct.setId(1L);
        savedProduct.setName(null);
        savedProduct.setDescription(null);
        savedProduct.setPrice(null);
        when(productRepository.save(any(Product.class))).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(inputProduct);
        // Assert
        assertNotNull(result);
        assertEquals(1L, result.getId());
        assertNull(result.getName());
        assertNull(result.getDescription());
        assertNull(result.getPrice());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("invalid")
    @DisplayName("Should propagate exception when repository throws exception")
    void handleRepositoryExceptionDuringCreation() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("Test Product");
        inputProduct.setDescription("Test Description");
        inputProduct.setPrice(new BigDecimal("99.99"));
        when(productRepository.save(any(Product.class))).thenThrow(new RuntimeException("Database error"));
        // Act & Assert
        Exception exception = assertThrows(RuntimeException.class, () -> {
            productController.createProduct(inputProduct);
        });
        
        assertEquals("Database error", exception.getMessage());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("boundary")
    @DisplayName("Should handle product with maximum field values")
    void createProductWithMaximumValues() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("A".repeat(255)); // Assuming 255 is the max length
        inputProduct.setDescription("B".repeat(1000)); // Assuming 1000 is the max length
        inputProduct.setPrice(new BigDecimal("999999999.99")); // Very large price
        Product savedProduct = new Product();
        savedProduct.setId(1L);
        savedProduct.setName("A".repeat(255));
        savedProduct.setDescription("B".repeat(1000));
        savedProduct.setPrice(new BigDecimal("999999999.99"));
        when(productRepository.save(any(Product.class))).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(inputProduct);
        // Assert
        assertNotNull(result);
        assertEquals(1L, result.getId());
        assertEquals("A".repeat(255), result.getName());
        assertEquals("B".repeat(1000), result.getDescription());
        assertEquals(new BigDecimal("999999999.99"), result.getPrice());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("integration")
    @DisplayName("Should verify correct repository interaction")
    void verifyRepositoryInteraction() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("Test Product");
        inputProduct.setDescription("Test Description");
        inputProduct.setPrice(new BigDecimal("99.99"));
        when(productRepository.save(any(Product.class))).thenReturn(inputProduct);
        // Act
        productController.createProduct(inputProduct);
        // Assert
        verify(productRepository, times(1)).save(same(inputProduct));
    }
    @Test
    @Tag("valid")
    @DisplayName("Should handle product with existing ID")
    void createProductWithExistingId() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setId(100L);
        inputProduct.setName("Existing Product");
        inputProduct.setDescription("Existing Description");
        inputProduct.setPrice(new BigDecimal("199.99"));
        Product savedProduct = new Product();
        savedProduct.setId(100L);
        savedProduct.setName("Existing Product");
        savedProduct.setDescription("Existing Description");
        savedProduct.setPrice(new BigDecimal("199.99"));
        when(productRepository.save(any(Product.class))).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(inputProduct);
        // Assert
        assertNotNull(result);
        assertEquals(100L, result.getId());
        assertEquals("Existing Product", result.getName());
        assertEquals("Existing Description", result.getDescription());
        assertEquals(new BigDecimal("199.99"), result.getPrice());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("integration")
    @DisplayName("Should handle multiple product creations in succession")
    void performanceUnderLoad() {
        // Arrange
        int requestCount = 10;
        List<Product> products = new ArrayList<>();
        
        for (int i = 0; i < requestCount; i++) {
            Product product = new Product();
            product.setName("Product " + i);
            product.setDescription("Description " + i);
            product.setPrice(new BigDecimal(i * 10.0));
            products.add(product);
            
            when(productRepository.save(same(product))).thenReturn(product);
        }
        
        // Act & Assert
        for (int i = 0; i < requestCount; i++) {
            Product result = productController.createProduct(products.get(i));
            
            assertNotNull(result);
            assertEquals("Product " + i, result.getName());
            assertEquals("Description " + i, result.getDescription());
            assertEquals(new BigDecimal(i * 10.0), result.getPrice());
        }
        
        verify(productRepository, times(requestCount)).save(any(Product.class));
    }
    @ParameterizedTest
    @MethodSource("provideProductsWithDifferentPrices")
    @Tag("boundary")
    @DisplayName("Should handle products with different price points")
    void createProductWithDifferentPrices(BigDecimal price, boolean isValid) {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("Price Test Product");
        inputProduct.setDescription("Testing different prices");
        inputProduct.setPrice(price);
        if (isValid) {
            when(productRepository.save(any(Product.class))).thenReturn(inputProduct);
            
            // Act
            Product result = productController.createProduct(inputProduct);
            
            // Assert
            assertNotNull(result);
            assertEquals(price, result.getPrice());
            verify(productRepository, times(1)).save(inputProduct);
        } else {
            when(productRepository.save(any(Product.class))).thenThrow(new IllegalArgumentException("Invalid price"));
            
            // Act & Assert
            Exception exception = assertThrows(IllegalArgumentException.class, () -> {
                productController.createProduct(inputProduct);
            });
            
            assertEquals("Invalid price", exception.getMessage());
            verify(productRepository, times(1)).save(inputProduct);
        }
    }
    private static Stream<Arguments> provideProductsWithDifferentPrices() {
        return Stream.of(
            Arguments.of(BigDecimal.ZERO, true),
            Arguments.of(new BigDecimal("0.01"), true),
            Arguments.of(new BigDecimal("9999.99"), true),
            Arguments.of(new BigDecimal("-1.0"), false)
        );
    }
}